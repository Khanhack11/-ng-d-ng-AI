{
  "name": "szshop-payment-gateway",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node szshop-backend/server.js",
    "agent": "python agent_service/run_server.py",
    "dev:all": "concurrently --kill-others -n \"BACKEND,VITE\" -c \"blue,green\" \"npm run server\" \"npm run dev\"",
    "dev:full": "concurrently --kill-others -n \"BACKEND,AGENT,VITE\" -c \"blue,yellow,green\" \"npm run server\" \"npm run agent\" \"npm run dev\"",
    "start": "npm run dev:all",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "^0.562.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.27",
    "concurrently": "^10.0.5",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
